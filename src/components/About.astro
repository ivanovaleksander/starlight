---
/**
 * За адвокат Хинков – професионално представяне.
 * Текстовете са предоставени и потвърдени от възложителя.
 */
import LinkedInLink from './LinkedInLink.astro';
import Portrait from './Portrait.astro';
import { t, i18n } from '../i18n';

/** Ключове в локалите: about.<key>Label / about.<key> */
const facts = ['bio', 'education', 'experience', 'membership'] as const;
---

<section id="za-men" class="section theme-light about" aria-labelledby="about-title">
	<div class="container about__grid">
		<div class="about__aside" data-reveal>
			<div class="about__portrait">
				<!-- Реалната снимка: src/assets/portrait/about.jpg (виж README там) -->
				<Portrait variant="about" sizes="(min-width: 56rem) 22rem, 90vw" />
			</div>
			<div class="about__aside-meta">
				<p class="about__name" {...i18n('site.person')}>{t('site.person')}</p>
				<p class="muted" {...i18n('site.barAssociation')}>{t('site.barAssociation')}</p>
				<LinkedInLink variant="button" size={18} class="about__li" />
			</div>
		</div>

		<div class="about__content">
			<p class="eyebrow" data-reveal {...i18n('about.eyebrow')}>{t('about.eyebrow')}</p>
			<h2 id="about-title" data-reveal style="--reveal-delay:1" {...i18n('about.title')}>{t('about.title')}</h2>
			<p class="lead about__lead" data-reveal style="--reveal-delay:2" {...i18n('about.lead')}>{t('about.lead')}</p>

			<dl class="about__facts" data-reveal style="--reveal-delay:3">
				{
					facts.map((f) => (
						<div class="about__fact">
							<dt {...i18n(`about.${f}Label`)}>{t(`about.${f}Label`)}</dt>
							<dd {...i18n(`about.${f}`)}>{t(`about.${f}`)}</dd>
						</div>
					))
				}
				<div class="about__fact">
					<dt {...i18n('about.approachLabel')}>{t('about.approachLabel')}</dt>
					<dd>
						<ul class="about__approach">
							<li {...i18n('about.approach1')}>{t('about.approach1')}</li>
							<li {...i18n('about.approach2')}>{t('about.approach2')}</li>
							<li {...i18n('about.approach3')}>{t('about.approach3')}</li>
						</ul>
					</dd>
				</div>
			</dl>

			<div class="about__actions" data-reveal style="--reveal-delay:4">
				<LinkedInLink variant="button" size={18} />
			</div>
		</div>
	</div>
</section>

<style>
	.about__grid {
		display: grid;
		gap: 3rem;
	}
	.about__aside {
		display: grid;
		gap: 1.5rem;
		align-content: start;
	}
	.about__portrait {
		aspect-ratio: 4 / 5;
		max-width: 22rem;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--navy-800);
		border: 1px solid var(--line);
		box-shadow: 0 30px 60px -30px rgba(12, 22, 38, 0.45);
	}
	.about__portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}
	.about__aside-meta {
		display: grid;
		gap: 0.35rem;
		font-size: var(--text-sm);
	}
	.about__name {
		font-family: var(--font-display);
		font-size: 1.35rem;
	}
	.about__li {
		margin-top: 0.75rem;
		justify-self: start;
	}

	.about__content h2 {
		margin-top: 1rem;
	}
	.about__lead {
		margin-top: 1.5rem;
	}

	.about__facts {
		margin: 2.5rem 0 0;
		border-top: 1px solid var(--line);
	}
	.about__fact {
		display: grid;
		gap: 0.5rem;
		padding: 1.35rem 0;
		border-bottom: 1px solid var(--line);
	}
	.about__fact dt {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.about__fact dd {
		margin: 0;
		color: var(--fg-muted);
	}
	.about__approach {
		display: grid;
		gap: 0.6rem;
	}
	.about__approach li {
		position: relative;
		padding-left: 1.25rem;
	}
	.about__approach li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.5rem;
		height: 1px;
		background: var(--accent-line);
	}
	.about__actions {
		margin-top: 2rem;
	}

	@media (min-width: 56rem) {
		.about__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 5rem;
		}
		.about__aside {
			position: sticky;
			top: calc(var(--header-total) + 2rem);
		}
		.about__aside .about__li {
			display: none;
		}
		.about__fact {
			grid-template-columns: 14rem minmax(0, 1fr);
			gap: 2rem;
		}
	}
	@media (max-width: 55.99rem) {
		.about__actions {
			display: none;
		}
	}
</style>
