---
/**
 * Контакти – лява колона с данни и пояснение; вдясно процесът за резервиране
 * на консултация (BookingFlow). Картата се показва само при наличен адрес.
 */
import MapPin from '@lucide/astro/icons/map-pin';
import Phone from '@lucide/astro/icons/phone';
import Mail from '@lucide/astro/icons/mail';
import Clock from '@lucide/astro/icons/clock';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import LinkedInLink from './LinkedInLink.astro';
import BookingFlow from './booking/BookingFlow.astro';
import { site, PLACEHOLDER } from '../data/site';

const details = [
	{ icon: MapPin, label: 'Адрес', value: site.contact.address },
	{ icon: Phone, label: 'Телефон', value: site.contact.phone },
	{ icon: Mail, label: 'Имейл', value: site.contact.email },
	{ icon: Clock, label: 'Работно време', value: site.contact.hours },
];
const isPlaceholder = (v: string | null) => !v || v === PLACEHOLDER;
---

<section id="kontakti" class="section theme-dark contact" aria-labelledby="contact-title">
	<div class="container contact__grid">
		<div class="contact__info">
			<p class="eyebrow" data-reveal>Контакти</p>
			<h2 id="contact-title" data-reveal style="--reveal-delay:1">Запазете консултация.</h2>
			<p class="lead" data-reveal style="--reveal-delay:2">
				Опишете накратко казуса си и ще се свържа с вас, за да уточним следващите стъпки.
			</p>

			<ul class="contact__details" data-reveal style="--reveal-delay:3">
				{
					details.map(({ icon: Icon, label, value }) => (
						<li>
							<span class="contact__icon" aria-hidden="true">
								<Icon size={18} stroke-width={1.6} />
							</span>
							<span>
								<span class="contact__label">{label}</span>
								{isPlaceholder(value) ? (
									<span class="placeholder">{PLACEHOLDER}</span>
								) : label === 'Имейл' ? (
									<a href={`mailto:${value}`} class="u-link">
										{value}
									</a>
								) : label === 'Телефон' ? (
									<a href={`tel:${value!.replace(/\s+/g, '')}`} class="u-link">
										{value}
									</a>
								) : (
									<span>{value}</span>
								)}
							</span>
						</li>
					))
				}
			</ul>

			<div class="contact__map" data-reveal style="--reveal-delay:4">
				{
					site.contact.mapEmbedUrl ? (
						<iframe
							src={site.contact.mapEmbedUrl}
							title="Карта с местоположението на кантората"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						/>
					) : site.contact.mapUrl ? (
						<a
							href={site.contact.mapUrl}
							class="contact__map-link"
							target="_blank"
							rel="noopener noreferrer"
						>
							<MapPin size={18} aria-hidden="true" />
							<span>
								<strong>Вижте кантората на картата</strong>
								<span class="contact__map-sub">{site.contact.address} · отваря се в Google Maps</span>
							</span>
							<ArrowUpRight size={18} aria-hidden="true" class="contact__map-arrow" />
						</a>
					) : (
						<p class="contact__map-note">
							<MapPin size={16} aria-hidden="true" />
							Картата ще бъде добавена след предоставяне на точен адрес.
						</p>
					)
				}
			</div>

			<div class="contact__social" data-reveal style="--reveal-delay:4">
				<LinkedInLink variant="text" label="Свържете се и в LinkedIn" size={18} />
			</div>
		</div>

		<div class="contact__form-wrap theme-light" data-reveal style="--reveal-delay:2">
			<!-- Процес за резервиране на консултация (3 стъпки) – виж src/components/booking/ и src/config/booking.ts -->
			<BookingFlow />
		</div>
	</div>
</section>

<style>
	.contact__grid {
		display: grid;
		gap: 3rem;
	}
	.contact__info h2 {
		margin-top: 1rem;
	}
	.contact__info .lead {
		margin-top: 1.25rem;
	}
	.contact__details {
		display: grid;
		gap: 1.1rem;
		margin-top: 2.5rem;
	}
	.contact__details li {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}
	.contact__details li > span:last-child {
		display: grid;
		gap: 0.15rem;
	}
	.contact__icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--bronze);
	}
	.contact__label {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fg-subtle);
	}
	.contact__map {
		margin-top: 2rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}
	.contact__map iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
	}
	.contact__map-link {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1rem 1.25rem;
		color: var(--fg);
		transition: background-color var(--dur-fast) var(--ease-out);
	}
	.contact__map-link > svg:first-child {
		flex: none;
		color: var(--bronze);
	}
	.contact__map-link > span {
		display: grid;
		gap: 0.15rem;
		flex: 1;
	}
	.contact__map-sub {
		font-size: var(--text-xs);
		color: var(--fg-subtle);
	}
	.contact__map-arrow {
		flex: none;
		color: var(--bronze);
		transition: transform var(--dur) var(--ease-out);
	}
	.contact__map-link:hover,
	.contact__map-link:focus-visible {
		background: rgba(201, 166, 107, 0.08);
	}
	.contact__map-link:hover .contact__map-arrow {
		transform: translate(3px, -3px);
	}
	.contact__map-note {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		padding: 1rem 1.25rem;
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}
	.contact__social {
		margin-top: 1.5rem;
	}

	/* Форма */
	.contact__form-wrap {
		position: relative;
		background: var(--paper);
		color: var(--ink);
		border-radius: var(--radius-lg);
		padding: clamp(1.5rem, 3.5vw, 2.75rem);
		box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
	}
	@media (min-width: 60rem) {
		.contact__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 5rem;
			align-items: start;
		}
	}
</style>
