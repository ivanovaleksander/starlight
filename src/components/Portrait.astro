---
/**
 * Портрет на адвокат Тодор Хинков.
 * Търси src/assets/portrait/{variant}.{jpg,jpeg,png,webp}; ако файлът липсва,
 * показва неутралния placeholder. Реалните снимки се оптимизират чрез astro:assets (sharp).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	variant: 'hero' | 'about';
	class?: string;
	loading?: 'eager' | 'lazy';
	sizes?: string;
}
const { variant, class: className, loading = 'lazy', sizes = '(min-width: 56rem) 24rem, 90vw' } =
	Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/portrait/{hero,about}.{jpg,jpeg,png,webp}',
	{ eager: true },
);
const match = Object.entries(files).find(([path]) => new RegExp(`/${variant}\\.(jpe?g|png|webp)$`).test(path));
const image = match?.[1].default;
---

{
	image ? (
		<Picture
			src={image}
			formats={['avif', 'webp']}
			fallbackFormat="jpg"
			widths={[480, 800, 1200, 1600]}
			sizes={sizes}
			alt="Адвокат Тодор Хинков"
			loading={loading}
			fetchpriority={loading === 'eager' ? 'high' : undefined}
			decoding="async"
			class={className}
		/>
	) : (
		<img
			src="/images/portrait-placeholder.svg"
			alt="Място за професионален портрет на адвокат Тодор Хинков"
			width="800"
			height="1000"
			loading={loading}
			fetchpriority={loading === 'eager' ? 'high' : undefined}
			decoding="async"
			class={className}
		/>
	)
}
