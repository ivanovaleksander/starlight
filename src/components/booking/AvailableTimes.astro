---
/**
 * Стъпка 2 – панел „Свободни часове“. Има няколко състояния, които скриптът превключва:
 * idle (няма избрана дата), loading, list (реални часове от API), empty, error,
 * external (няма API – часът се избира/потвърждава в Microsoft Bookings), demo (само dev).
 */
import LoaderCircle from '@lucide/astro/icons/loader-circle';
import CircleAlert from '@lucide/astro/icons/circle-alert';
import ExternalLink from '@lucide/astro/icons/external-link';
import Info from '@lucide/astro/icons/info';
import { BOOKING_CONFIG } from '../../config/booking';
---

<div class="bk-times" data-times>
	<div class="bk-times__head">
		<h4 class="bk-times__title">Свободни часове</h4>
		<p class="bk-times__sub" data-times-sub>Първо изберете дата от календара.</p>
	</div>

	<div data-times-state="idle" class="bk-times__state">
		<p class="bk-times__muted">След избор на дата тук ще видите възможните часове.</p>
	</div>

	<div data-times-state="loading" class="bk-times__state" hidden>
		<p class="bk-times__muted bk-times__loading">
			<LoaderCircle size={18} stroke-width={1.7} aria-hidden="true" class="bk-spin" />
			Проверка на свободните часове…
		</p>
	</div>

	<div data-times-state="list" class="bk-times__state" hidden>
		<div class="bk-times__list" data-times-list role="radiogroup" aria-label="Свободни часове"></div>
		<p class="bk-times__demo" data-times-demo hidden>
			<Info size={16} aria-hidden="true" />
			Демо часове – показват се само в режим на разработка.
		</p>
	</div>

	<div data-times-state="empty" class="bk-times__state" hidden>
		<p class="bk-times__muted">За избраната дата няма свободни часове. Изберете друга дата.</p>
	</div>

	<div data-times-state="error" class="bk-times__state" hidden>
		<p class="bk-times__error" role="alert">
			<CircleAlert size={18} aria-hidden="true" />
			Свободните часове не могат да бъдат заредени в момента. Опитайте отново или продължете –
			ще потвърдим часа с вас.
		</p>
	</div>

	<div data-times-state="external" class="bk-times__state" hidden>
		<p class="bk-times__muted">
			Свободните часове се управляват в Microsoft Bookings. Изберете предпочитана дата и
			продължете – точният час се избира и потвърждава там.
		</p>
		{
			BOOKING_CONFIG.bookingPageUrl ? (
				<a
					class="bk-link"
					href={BOOKING_CONFIG.bookingPageUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					Отвори Microsoft Bookings <ExternalLink size={15} aria-hidden="true" />
				</a>
			) : (
				<p class="bk-times__notice">
					<Info size={16} aria-hidden="true" />
					Резервационната страница все още не е свързана. Заявката ви ще бъде потвърдена по
					телефон или имейл.
				</p>
			)
		}
	</div>
</div>
