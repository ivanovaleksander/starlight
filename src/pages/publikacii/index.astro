---
/** Списък с всички публикации. */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { t, both, i18n } from '../../i18n';
import { pairPosts } from '../../i18n/publications';

const pairs = pairPosts(await getCollection('publications'));
const allDemo = pairs.every((p) => p.bg.data.demo);
---

<BaseLayout title={both('seo.publicationsTitle')} description={both('seo.publicationsDescription')} noindex={allDemo}>
	<section class="pubs theme-light">
		<div class="container">
			<a href="/" class="pubs__back u-link" {...i18n('nav.backHome')}>{t('nav.backHome')}</a>
			<p class="eyebrow" {...i18n('publications.eyebrow')}>{t('publications.eyebrow')}</p>
			<h1 class="pubs__title" {...i18n('publications.title')}>{t('publications.title')}</h1>
			<div class="pubs__grid">
				{pairs.map((pair, i) => <PublicationCard pair={pair} index={i} />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.pubs {
		padding-top: calc(var(--header-h) + clamp(3rem, 6vw, 5rem));
		padding-bottom: var(--section-y);
		background: var(--paper);
		color: var(--ink);
	}
	.pubs__back {
		display: table;
		margin-bottom: 2.5rem;
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}
	.pubs__title {
		font-size: var(--text-h2);
		margin: 1rem 0 2.5rem;
		max-width: 16ch;
	}
	.pubs__grid {
		display: grid;
		gap: 1.25rem;
	}
	@media (min-width: 40rem) {
		.pubs__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 56rem) {
		.pubs__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}
</style>
