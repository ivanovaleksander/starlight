---
/**
 * За адвокат Хинков – професионално представяне.
 * Текстовете са предоставени и потвърдени от възложителя.
 */
import LinkedInLink from './LinkedInLink.astro';
import Portrait from './Portrait.astro';
import { site, PLACEHOLDER } from '../data/site';

const facts = [
	{
		label: 'Биографична информация',
		value:
			'Адвокат Тодор Хинков е член на Адвокатска колегия – Пловдив и упражнява адвокатска професия от 2013 г. Практиката му съчетава процесуално представителство и правно обслужване на граждани и дружества с натрупан опит като вътрешен юридически съветник на корпоративни организации.',
	},
	{
		label: 'Образование',
		value:
			'Завършва Английската езикова гимназия в Пловдив, а през 2012 г. придобива магистърска степен по право от Пловдивския университет „Паисий Хилендарски“. Професионалната му подготовка обхваща договорното, дружественото, търговското, гражданското и административното право.',
	},
	{
		label: 'Професионален опит',
		value:
			'Притежава над 13 години адвокатски опит. Бил е юридически съветник на Bella Bulgaria в периода 2012–2020 г. и на SKF Group между 2020 и 2024 г. Консултира по корпоративни и търговски въпроси, учредяване и преобразуване на дружества, договори, сделки с недвижими имоти, трудово право и защита на личните данни. Представлява граждани и компании пред съдилища, нотариуси, съдебни изпълнители и други институции.',
	},
	{ label: 'Членство', value: `${site.barAssociation}, вписан от ${site.memberSince} г. Личен номер ${site.registryNumber}.` },
];
---

<section id="za-men" class="section theme-dark about" aria-labelledby="about-title">
	<div class="container about__grid">
		<div class="about__aside" data-reveal>
			<div class="about__portrait">
				<!-- Реалната снимка: src/assets/portrait/about.jpg (виж README там) -->
				<Portrait variant="about" sizes="(min-width: 56rem) 22rem, 90vw" />
			</div>
			<div class="about__aside-meta">
				<p class="about__name">{site.person}</p>
				<p class="muted">{site.barAssociation}</p>
				<LinkedInLink variant="button" size={18} class="about__li" />
			</div>
		</div>

		<div class="about__content">
			<p class="eyebrow" data-reveal>За мен</p>
			<h2 id="about-title" data-reveal style="--reveal-delay:1">За адвокат Хинков</h2>
			<p class="lead about__lead" data-reveal style="--reveal-delay:2">
				{site.subtitle} Работа с фокус върху яснота, предвидимост и последователни действия
				във всеки етап от казуса.
			</p>

			<dl class="about__facts" data-reveal style="--reveal-delay:3">
				{
					facts.map((f) => (
						<div class="about__fact">
							<dt>{f.label}</dt>
							<dd>{f.value ?? <span class="placeholder">{PLACEHOLDER}</span>}</dd>
						</div>
					))
				}
				<div class="about__fact">
					<dt>Подход към работата</dt>
					<dd>
						<ul class="about__approach">
							<li>Предварителна оценка на казуса и честна информация за възможностите.</li>
							<li>Ясна правна стратегия с конкретни стъпки и срокове.</li>
							<li>Последователни действия и редовна комуникация с клиента.</li>
						</ul>
					</dd>
				</div>
			</dl>

			<div class="about__actions" data-reveal style="--reveal-delay:4">
				<LinkedInLink variant="button" size={18} />
			</div>
		</div>
	</div>
</section>

<style>
	.about__grid {
		display: grid;
		gap: 3rem;
	}
	.about__aside {
		display: grid;
		gap: 1.5rem;
		align-content: start;
	}
	.about__portrait {
		aspect-ratio: 4 / 5;
		max-width: 22rem;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--navy-800);
		border: 1px solid var(--line);
	}
	.about__portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}
	.about__aside-meta {
		display: grid;
		gap: 0.35rem;
		font-size: var(--text-sm);
	}
	.about__name {
		font-family: var(--font-display);
		font-size: 1.35rem;
	}
	.about__li {
		margin-top: 0.75rem;
		justify-self: start;
	}

	.about__content h2 {
		margin-top: 1rem;
	}
	.about__lead {
		margin-top: 1.5rem;
	}

	.about__facts {
		margin: 2.5rem 0 0;
		border-top: 1px solid var(--line);
	}
	.about__fact {
		display: grid;
		gap: 0.5rem;
		padding: 1.35rem 0;
		border-bottom: 1px solid var(--line);
	}
	.about__fact dt {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.about__fact dd {
		margin: 0;
		color: var(--fg-muted);
	}
	.about__approach {
		display: grid;
		gap: 0.6rem;
	}
	.about__approach li {
		position: relative;
		padding-left: 1.25rem;
	}
	.about__approach li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.5rem;
		height: 1px;
		background: var(--accent-line);
	}
	.about__actions {
		margin-top: 2rem;
	}

	@media (min-width: 56rem) {
		.about__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 5rem;
		}
		.about__aside {
			position: sticky;
			top: calc(var(--header-h) + 2rem);
		}
		.about__aside .about__li {
			display: none;
		}
		.about__fact {
			grid-template-columns: 14rem minmax(0, 1fr);
			gap: 2rem;
		}
	}
	@media (max-width: 55.99rem) {
		.about__actions {
			display: none;
		}
	}
</style>
