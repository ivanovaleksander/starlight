---
/**
 * Layout за правните подстраници (политики, декларации).
 * Съдържанието е ЧЕРНОВА за преглед и одобрение от адвокат Хинков.
 */
import BaseLayout from './BaseLayout.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { site, legalLinks } from '../data/site';

interface Props {
	title: string;
	description: string;
	/** Кратко описание на правната рамка, показва се под заглавието. */
	basis?: string;
}
const { title, description, basis } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');
---

<BaseLayout title={`${title} | ${site.brand}`} description={description} noindex>
	<article class="legal theme-light">
		<div class="container legal__grid">
			<aside class="legal__aside">
				<a href="/" class="legal__back u-link">← Обратно към началото</a>
				<nav aria-label="Правни документи" class="legal__nav">
					<p class="legal__nav-title">Правни документи</p>
					<ul>
						{
							legalLinks.map((l) => (
								<li>
									<a
										href={l.href}
										class:list={['legal__nav-link', current === l.href && 'is-current']}
										aria-current={current === l.href ? 'page' : undefined}
									>
										{l.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</aside>

			<div class="legal__main">
				<p class="eyebrow">Правна информация</p>
				<h1 class="legal__title">{title}</h1>
				{basis && <p class="legal__basis">{basis}</p>}
				<p class="legal__updated">
					Последна актуализация: <span class="placeholder">[дата на публикуване]</span>
				</p>

				<div class="legal__notice" role="note">
					<p>
						<strong>Чернова за преглед.</strong> Документът е изготвен като пълна структурирана
						чернова и трябва да бъде прегледан, допълнен и одобрен от адвокат Хинков преди
						публикуване. Полетата в <span class="placeholder">[квадратни скоби]</span> се попълват с
						реални данни. До одобрението страницата не се индексира от търсачки.
					</p>
				</div>

				<div class="legal__body">
					<slot />
				</div>

				<a href="/#kontakti" class="legal__cta">
					Въпроси относно този документ <ArrowRight size={16} aria-hidden="true" />
				</a>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.legal {
		padding-top: calc(var(--header-h) + clamp(3rem, 6vw, 5rem));
		padding-bottom: var(--section-y);
		background: var(--paper);
		color: var(--ink);
	}
	.legal__grid {
		display: grid;
		gap: 3rem;
	}
	.legal__aside {
		display: grid;
		gap: 2rem;
		align-content: start;
	}
	.legal__back {
		font-size: var(--text-sm);
		color: var(--fg-muted);
		justify-self: start;
	}
	.legal__nav-title {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg-subtle);
		margin-bottom: 0.75rem;
	}
	.legal__nav ul {
		display: grid;
		border-top: 1px solid var(--line);
	}
	.legal__nav-link {
		display: block;
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--line);
		font-size: var(--text-sm);
		color: var(--fg-muted);
		transition: color var(--dur-fast) var(--ease-out);
	}
	.legal__nav-link:hover,
	.legal__nav-link:focus-visible,
	.legal__nav-link.is-current {
		color: var(--bronze-deep);
	}
	.legal__nav-link.is-current {
		font-weight: 600;
	}

	.legal__main {
		max-width: 46rem;
	}
	.legal__title {
		font-size: var(--text-h2);
		margin: 1rem 0 1rem;
	}
	.legal__basis {
		color: var(--fg-muted);
		font-size: var(--text-md);
	}
	.legal__updated {
		margin-top: 1rem;
		font-size: var(--text-sm);
		color: var(--fg-subtle);
	}
	.legal__notice {
		margin: 2rem 0 2.5rem;
		padding: 1rem 1.25rem;
		border: 1px dashed var(--line-strong);
		border-radius: var(--radius);
		background: var(--paper-2);
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	.legal__body {
		counter-reset: section;
	}
	.legal__body :global(h2) {
		font-size: var(--text-h3);
		margin: 2.5rem 0 0.85rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
	.legal__body :global(h3) {
		font-family: var(--font-sans);
		font-size: var(--text-md);
		font-weight: 600;
		margin: 1.5rem 0 0.5rem;
	}
	.legal__body :global(p),
	.legal__body :global(li),
	.legal__body :global(td),
	.legal__body :global(th) {
		color: var(--fg-muted);
		font-size: var(--text-base);
		line-height: 1.65;
	}
	.legal__body :global(p + p) {
		margin-top: 0.85em;
	}
	.legal__body :global(ul),
	.legal__body :global(ol) {
		display: grid;
		gap: 0.45rem;
		margin: 0.75rem 0;
		padding-left: 1.35rem;
	}
	.legal__body :global(ul) {
		list-style: disc;
	}
	.legal__body :global(ol) {
		list-style: decimal;
	}
	.legal__body :global(strong) {
		color: var(--ink);
		font-weight: 600;
	}
	.legal__body :global(a) {
		color: var(--bronze-deep);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.legal__body :global(.table-wrap) {
		overflow-x: auto;
		margin: 1rem 0;
	}
	.legal__body :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-sm);
	}
	.legal__body :global(th),
	.legal__body :global(td) {
		text-align: left;
		vertical-align: top;
		padding: 0.65rem 0.75rem;
		border-bottom: 1px solid var(--line);
		font-size: var(--text-sm);
	}
	.legal__body :global(th) {
		color: var(--ink);
		font-weight: 600;
		background: var(--paper-2);
	}
	.legal__body :global(.callout) {
		margin: 1rem 0;
		padding: 0.9rem 1.1rem;
		border-left: 2px solid var(--bronze-2);
		background: var(--paper-2);
		font-size: var(--text-sm);
	}

	.legal__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 3rem;
		font-weight: 600;
		font-size: var(--text-sm);
		color: var(--bronze-deep);
	}

	@media (min-width: 60rem) {
		.legal__grid {
			grid-template-columns: 16rem minmax(0, 1fr);
			gap: 5rem;
		}
		.legal__aside {
			position: sticky;
			top: calc(var(--header-h) + 2rem);
		}
	}
</style>
