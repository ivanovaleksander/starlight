# Публичен адрес на сайта (за canonical, Open Graph и структурирани данни)
PUBLIC_SITE_URL=https://www.example.bg

# Endpoint, към който контактната форма изпраща запитванията (POST, JSON).
# Ако е празен, формата работи в демо режим и НЕ изпраща данни никъде.
# Примери: Netlify Function, Formspree, собствен API.
PUBLIC_CONTACT_ENDPOINT=

# ---- Резервиране на консултация (src/config/booking.ts) ----
# Публичната страница на кантората в Microsoft Bookings. Отваря се при потвърждаване
# на резервация, докато няма API интеграция. Заменете с реалния адрес.
PUBLIC_BOOKING_PAGE_URL=https://outlook.office.com/book/REPLACE_WITH_REAL_URL

# По избор – реална наличност и създаване на резервации през собствен API/функция:
#   GET  {PUBLIC_BOOKING_AVAILABILITY_URL}?service=office&date=2026-09-15 → { "slots": [{ "start": ISO, "end": ISO }] }
#   POST {PUBLIC_BOOKING_CREATE_URL} с JSON тялото на резервацията
# Без тях сайтът не показва измислени часове и изпраща заявка (PUBLIC_CONTACT_ENDPOINT).
PUBLIC_BOOKING_AVAILABILITY_URL=
PUBLIC_BOOKING_CREATE_URL=
