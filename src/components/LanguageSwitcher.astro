---
/**
 * Превключвател на езика: BG / EN с флагове (инлайн SVG, без външни ресурси).
 * Смяната е мигновена (src/scripts/i18n.ts), изборът се пази в localStorage.
 */
import { t } from '../i18n';

interface Props {
	class?: string;
	[key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<div class:list={['lang', className]} role="group" aria-label={t('lang.switcherLabel')} data-i18n-attr="aria-label:lang.switcherLabel" {...rest}>
	<button type="button" class="lang__btn" data-lang-switch="bg" aria-pressed="true" lang="bg" title={t('lang.bg')}>
		<svg class="lang__flag" viewBox="0 0 24 16" aria-hidden="true" focusable="false">
			<rect width="24" height="16" fill="#fff" />
			<rect y="5.33" width="24" height="5.34" fill="#00966e" />
			<rect y="10.67" width="24" height="5.33" fill="#d62612" />
		</svg>
		<span>BG</span>
	</button>
	<button type="button" class="lang__btn" data-lang-switch="en" aria-pressed="false" lang="en" title={t('lang.en')}>
		<svg class="lang__flag" viewBox="0 0 60 30" aria-hidden="true" focusable="false">
			<clipPath id="lang-uk-clip"><path d="M30 15h30v15zv15H0zH0V0zV0h30z" /></clipPath>
			<path d="M0 0v30h60V0z" fill="#012169" />
			<path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6" />
			<path d="M0 0l60 30m0-30L0 30" clip-path="url(#lang-uk-clip)" stroke="#C8102E" stroke-width="4" />
			<path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
			<path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6" />
		</svg>
		<span>EN</span>
	</button>
</div>

<style>
	.lang {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: rgba(12, 22, 38, 0.35);
	}
	.lang__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		padding: 0.35rem 0.6rem;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--cream-2);
		transition:
			background-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}
	.lang__btn:hover {
		color: var(--cream);
	}
	.lang__btn:focus-visible {
		outline: 2px solid var(--bronze);
		outline-offset: 1px;
	}
	.lang__btn[aria-pressed='true'] {
		background: var(--bronze);
		color: var(--navy-950);
	}
	@media (pointer: coarse) {
		.lang__btn {
			min-height: 2.75rem;
		}
	}
	.lang__flag {
		width: 1.15rem;
		height: auto;
		border-radius: 2px;
		flex: none;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
	}
</style>
