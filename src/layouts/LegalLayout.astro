---
/**
 * Layout за правните подстраници (политики, декларации) – двуезичен.
 * Съдържанието на български идва в default slot-а, на английски – в slot="en".
 * Съдържанието е ЧЕРНОВА за преглед и одобрение от адвокат Хинков.
 */
import BaseLayout from './BaseLayout.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Logo from '../components/Logo.astro';
import { site, legalList, type LegalKey } from '../data/site';
import { t, both, i18n, i18nHtml, i18nAttr } from '../i18n';

interface Props {
	docKey: LegalKey;
}
const { docKey } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');
const title = both(`legal.docs.${docKey}.title`);
const description = both(`legal.docs.${docKey}.description`);
---

<BaseLayout title={{ bg: `${title.bg} | ${site.brand}`, en: `${title.en} | ${site.brand}` }} description={description} noindex>
	<article class="legal theme-light">
		<div class="container legal__grid">
			<aside class="legal__aside">
				<a href="/" class="legal__home" {...i18nAttr({ 'aria-label': 'nav.brandHome' })}>
					<Logo size={44} />
				</a>
				<a href="/" class="legal__back u-link" {...i18n('nav.backHome')}>{t('nav.backHome')}</a>
				<nav {...i18nAttr({ 'aria-label': 'legal.navTitle' })} class="legal__nav">
					<p class="legal__nav-title" {...i18n('legal.navTitle')}>{t('legal.navTitle')}</p>
					<ul>
						{
							legalList.map((l) => (
								<li>
									<a
										href={l.href}
										class:list={['legal__nav-link', current === l.href && 'is-current']}
										aria-current={current === l.href ? 'page' : undefined}
										{...i18n(`legal.docs.${l.key}.title`)}
									>
										{t(`legal.docs.${l.key}.title`)}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</aside>

			<div class="legal__main">
				<p class="eyebrow" {...i18n('legal.eyebrow')}>{t('legal.eyebrow')}</p>
				<h1 class="legal__title" {...i18n(`legal.docs.${docKey}.title`)}>{title.bg}</h1>
				<p class="legal__basis" {...i18n(`legal.docs.${docKey}.basis`)}>{t(`legal.docs.${docKey}.basis`)}</p>
				<p class="legal__updated">
					<span {...i18n('legal.updated')}>{t('legal.updated')}</span> <span class="placeholder" {...i18n('legal.updatedPlaceholder')}>{t('legal.updatedPlaceholder')}</span>
				</p>

				<div class="legal__notice" role="note">
					<p {...i18nHtml('legal.draftNotice')} set:html={t('legal.draftNotice')} />
				</div>

				<div class="legal__body prose" data-lang="bg" lang="bg">
					<slot />
				</div>
				<div class="legal__body prose" data-lang="en" lang="en">
					<slot name="en" />
				</div>

				<a href="/#kontakti" class="legal__cta">
					<span {...i18n('legal.question')}>{t('legal.question')}</span> <ArrowRight size={16} aria-hidden="true" />
				</a>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.legal {
		padding-top: calc(var(--header-h) + clamp(3rem, 6vw, 5rem));
		padding-bottom: var(--section-y);
		background: var(--paper);
		color: var(--ink);
	}
	.legal__grid {
		display: grid;
		gap: 3rem;
	}
	.legal__aside {
		display: grid;
		gap: 2rem;
		align-content: start;
	}
	.legal__home {
		color: var(--bronze-deep);
		justify-self: start;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.legal__home:hover,
	.legal__home:focus-visible {
		color: var(--ink);
	}
	.legal__back {
		font-size: var(--text-sm);
		color: var(--fg-muted);
		justify-self: start;
	}
	.legal__nav-title {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg-subtle);
		margin-bottom: 0.75rem;
	}
	.legal__nav ul {
		display: grid;
		border-top: 1px solid var(--line);
	}
	.legal__nav-link {
		display: block;
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--line);
		font-size: var(--text-sm);
		color: var(--fg-muted);
		transition: color var(--dur-fast) var(--ease-out);
	}
	.legal__nav-link:hover,
	.legal__nav-link:focus-visible,
	.legal__nav-link.is-current {
		color: var(--bronze-deep);
	}
	.legal__nav-link.is-current {
		font-weight: 600;
	}

	.legal__main {
		max-width: 46rem;
	}
	.legal__title {
		font-size: var(--text-h2);
		margin: 1rem 0 1rem;
	}
	.legal__basis {
		color: var(--fg-muted);
		font-size: var(--text-md);
	}
	.legal__updated {
		margin-top: 1rem;
		font-size: var(--text-sm);
		color: var(--fg-subtle);
	}
	.legal__notice {
		margin: 2rem 0 2.5rem;
		padding: 1rem 1.25rem;
		border: 1px dashed var(--line-strong);
		border-radius: var(--radius);
		background: var(--paper-2);
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}


	.legal__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 3rem;
		font-weight: 600;
		font-size: var(--text-sm);
		color: var(--bronze-deep);
	}

	@media (min-width: 60rem) {
		.legal__grid {
			grid-template-columns: 16rem minmax(0, 1fr);
			gap: 5rem;
		}
		.legal__aside {
			position: sticky;
			top: calc(var(--header-h) + 2rem);
		}
	}
</style>
