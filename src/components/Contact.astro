---
/**
 * Контакти – форма с валидиране (виж src/scripts/contact-form.ts),
 * контактни данни и пояснение. Картата се показва само при наличен адрес.
 */
import MapPin from '@lucide/astro/icons/map-pin';
import Phone from '@lucide/astro/icons/phone';
import Mail from '@lucide/astro/icons/mail';
import Clock from '@lucide/astro/icons/clock';
import CircleCheck from '@lucide/astro/icons/circle-check';
import CircleAlert from '@lucide/astro/icons/circle-alert';
import Button from './Button.astro';
import LinkedInLink from './LinkedInLink.astro';
import { site, contactTopics, PLACEHOLDER } from '../data/site';

const details = [
	{ icon: MapPin, label: 'Адрес', value: site.contact.address },
	{ icon: Phone, label: 'Телефон', value: site.contact.phone },
	{ icon: Mail, label: 'Имейл', value: site.contact.email },
	{ icon: Clock, label: 'Работно време', value: site.contact.hours },
];
const isPlaceholder = (v: string | null) => !v || v === PLACEHOLDER;
---

<section id="kontakti" class="section theme-dark contact" aria-labelledby="contact-title">
	<div class="container contact__grid">
		<div class="contact__info">
			<p class="eyebrow" data-reveal>Контакти</p>
			<h2 id="contact-title" data-reveal style="--reveal-delay:1">Запазете консултация.</h2>
			<p class="lead" data-reveal style="--reveal-delay:2">
				Опишете накратко казуса си и ще се свържа с вас, за да уточним следващите стъпки.
			</p>

			<ul class="contact__details" data-reveal style="--reveal-delay:3">
				{
					details.map(({ icon: Icon, label, value }) => (
						<li>
							<span class="contact__icon" aria-hidden="true">
								<Icon size={18} stroke-width={1.6} />
							</span>
							<span>
								<span class="contact__label">{label}</span>
								{isPlaceholder(value) ? (
									<span class="placeholder">{PLACEHOLDER}</span>
								) : label === 'Имейл' ? (
									<a href={`mailto:${value}`} class="u-link">
										{value}
									</a>
								) : label === 'Телефон' ? (
									<a href={`tel:${value!.replace(/\s+/g, '')}`} class="u-link">
										{value}
									</a>
								) : (
									<span>{value}</span>
								)}
							</span>
						</li>
					))
				}
			</ul>

			<div class="contact__map" data-reveal style="--reveal-delay:4">
				{
					site.contact.mapEmbedUrl ? (
						<iframe
							src={site.contact.mapEmbedUrl}
							title="Карта с местоположението на кантората"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						/>
					) : (
						<p class="contact__map-note">
							<MapPin size={16} aria-hidden="true" />
							Картата ще бъде добавена след предоставяне на точен адрес.
						</p>
					)
				}
			</div>

			<div class="contact__social" data-reveal style="--reveal-delay:4">
				<LinkedInLink variant="text" label="Свържете се и в LinkedIn" size={18} />
			</div>
		</div>

		<div class="contact__form-wrap theme-light" data-reveal style="--reveal-delay:2">
			<!--
				ВАЖНО: формата няма реален backend. Изпращането се обработва в
				src/scripts/contact-form.ts – там е отбелязано къде да се свърже
				реална услуга (PUBLIC_CONTACT_ENDPOINT).
			-->
			<form class="form" id="contact-form" novalidate data-contact-form>
				<h3 class="form__title">Изпратете запитване</h3>

				<div class="form__row">
					<div class="field">
						<label for="f-name">Име и фамилия <span aria-hidden="true">*</span></label>
						<input
							id="f-name"
							name="name"
							type="text"
							autocomplete="name"
							required
							minlength="2"
							aria-describedby="f-name-err"
						/>
						<p class="field__error" id="f-name-err" role="alert"></p>
					</div>
					<div class="field">
						<label for="f-phone">Телефон <span aria-hidden="true">*</span></label>
						<input
							id="f-phone"
							name="phone"
							type="tel"
							inputmode="tel"
							autocomplete="tel"
							required
							aria-describedby="f-phone-err"
						/>
						<p class="field__error" id="f-phone-err" role="alert"></p>
					</div>
				</div>

				<div class="form__row">
					<div class="field">
						<label for="f-email">Имейл <span aria-hidden="true">*</span></label>
						<input
							id="f-email"
							name="email"
							type="email"
							autocomplete="email"
							required
							aria-describedby="f-email-err"
						/>
						<p class="field__error" id="f-email-err" role="alert"></p>
					</div>
					<div class="field">
						<label for="f-topic">Тема на запитването <span aria-hidden="true">*</span></label>
						<select id="f-topic" name="topic" required aria-describedby="f-topic-err">
							<option value="">Изберете тема</option>
							{contactTopics.map((t) => <option value={t}>{t}</option>)}
						</select>
						<p class="field__error" id="f-topic-err" role="alert"></p>
					</div>
				</div>

				<div class="field">
					<label for="f-message">Кратко описание на казуса <span aria-hidden="true">*</span></label>
					<textarea
						id="f-message"
						name="message"
						rows="5"
						required
						minlength="20"
						maxlength="2000"
						aria-describedby="f-message-err f-message-hint"
					></textarea>
					<p class="field__hint" id="f-message-hint">
						Не изпращайте чувствителни лични данни (ЕГН, номера на документи) на този етап.
					</p>
					<p class="field__error" id="f-message-err" role="alert"></p>
				</div>

				<div class="field field--check">
					<input id="f-consent" name="consent" type="checkbox" required aria-describedby="f-consent-err" />
					<label for="f-consent">
						Съгласен/на съм личните ми данни да бъдат обработени за целите на запитването съгласно
						<a href="/politika-za-poveritelnost" class="u-link">Политиката за поверителност</a>.
						<span aria-hidden="true">*</span>
					</label>
					<p class="field__error" id="f-consent-err" role="alert"></p>
				</div>

				<!-- Honeypot срещу спам ботове -->
				<div class="form__hp" aria-hidden="true">
					<label for="f-website">Уебсайт</label>
					<input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<div class="form__actions">
					<Button type="submit" variant="primary" class="form__submit" arrow>
						Изпрати запитване
					</Button>
					<p class="form__status" data-form-status role="status" aria-live="polite"></p>
				</div>

				<p class="form__disclaimer">
					Изпращането на запитване не създава автоматично отношения между адвокат и клиент.
				</p>
			</form>

			<div class="form__success" data-form-success hidden tabindex="-1">
				<CircleCheck size={40} stroke-width={1.4} aria-hidden="true" />
				<h3>Запитването е изпратено.</h3>
				<p>Благодаря за доверието. Ще се свържа с вас възможно най-скоро.</p>
				<p class="form__disclaimer">
					Изпращането на запитване не създава автоматично отношения между адвокат и клиент.
				</p>
			</div>

			<div class="form__failure" data-form-failure hidden role="alert">
				<CircleAlert size={22} aria-hidden="true" />
				<p>
					Запитването не можа да бъде изпратено. Опитайте отново или се свържете директно по
					телефон или имейл.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.contact__grid {
		display: grid;
		gap: 3rem;
	}
	.contact__info h2 {
		margin-top: 1rem;
	}
	.contact__info .lead {
		margin-top: 1.25rem;
	}
	.contact__details {
		display: grid;
		gap: 1.1rem;
		margin-top: 2.5rem;
	}
	.contact__details li {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}
	.contact__details li > span:last-child {
		display: grid;
		gap: 0.15rem;
	}
	.contact__icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--bronze);
	}
	.contact__label {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fg-subtle);
	}
	.contact__map {
		margin-top: 2rem;
		border: 1px dashed var(--line-strong);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}
	.contact__map iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
	}
	.contact__map-note {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		padding: 1rem 1.25rem;
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}
	.contact__social {
		margin-top: 1.5rem;
	}

	/* Форма */
	.contact__form-wrap {
		position: relative;
		background: var(--paper);
		color: var(--ink);
		border-radius: var(--radius-lg);
		padding: clamp(1.5rem, 3.5vw, 2.75rem);
		box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
	}
	.form {
		display: grid;
		gap: 1.25rem;
	}
	.form__title {
		font-size: var(--text-h3);
		margin-bottom: 0.25rem;
	}
	.form__row {
		display: grid;
		gap: 1.25rem;
	}
	.field {
		display: grid;
		gap: 0.4rem;
	}
	.field label {
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.field label span[aria-hidden] {
		color: var(--bronze-deep);
	}
	.field input,
	.field select,
	.field textarea {
		width: 100%;
		padding: 0.8rem 0.95rem;
		background: #fff;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		transition:
			border-color var(--dur-fast) var(--ease-out),
			box-shadow var(--dur-fast) var(--ease-out);
	}
	.field textarea {
		resize: vertical;
		min-height: 8rem;
	}
	.field input:focus,
	.field select:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--bronze-deep);
		box-shadow: 0 0 0 3px rgba(176, 141, 87, 0.25);
	}
	.field [aria-invalid='true'] {
		border-color: #a83a2c;
	}
	.field__hint {
		font-size: var(--text-xs);
		color: var(--fg-subtle);
	}
	.field__error {
		font-size: var(--text-xs);
		color: #9a2f22;
		min-height: 1em;
	}
	.field__error:empty {
		display: none;
	}
	.field--check {
		grid-template-columns: auto 1fr;
		align-items: start;
		gap: 0.75rem;
	}
	.field--check label {
		font-weight: 400;
		font-size: var(--text-sm);
		line-height: 1.5;
	}
	.field--check input {
		width: 1.15rem;
		height: 1.15rem;
		margin-top: 0.2rem;
		accent-color: var(--bronze-deep);
	}
	.field--check .field__error {
		grid-column: 1 / -1;
	}
	.form__hp {
		position: absolute;
		left: -10000px;
		top: auto;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.form__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-top: 0.25rem;
	}
	.form__status {
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}
	.form__disclaimer {
		font-size: var(--text-xs);
		color: var(--fg-subtle);
		padding-top: 0.75rem;
		border-top: 1px solid var(--line);
	}
	.form.is-submitting {
		opacity: 0.7;
		pointer-events: none;
	}

	.form__success {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
		color: var(--ink);
		animation: fade-up var(--dur-slow) var(--ease-out);
	}
	.form__success svg {
		color: var(--bronze-deep);
	}
	.form__failure {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		margin-top: 1rem;
		padding: 1rem;
		border: 1px solid #c9564a;
		border-radius: var(--radius);
		color: #7f2419;
		font-size: var(--text-sm);
		background: #fbeceb;
	}
	.form__failure svg {
		flex: none;
	}
	[hidden] {
		display: none !important;
	}

	@media (min-width: 40rem) {
		.form__row {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (min-width: 60rem) {
		.contact__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 5rem;
			align-items: start;
		}
	}
</style>
