---
/**
 * Основен layout: <head> с SEO, Open Graph, структурирани данни,
 * самостоятелно хоствани шрифтове, skip link, header и footer.
 * Двуезичност: html[lang] се задава рано от inline скрипт (localStorage),
 * а текстовете се превеждат от src/scripts/i18n.ts без презареждане.
 */
import '@fontsource-variable/manrope';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, services } from '../data/site';
import { t, both, l10n, l10nAttr, i18nAttr, i18n, type Localized } from '../i18n';

interface Props {
	title?: Localized;
	description?: Localized;
	/** За подстраници с временно съдържание – да не се индексират. */
	noindex?: boolean;
	/** Включва JSON-LD за LegalService/Attorney (само на началната страница). */
	structuredData?: boolean;
}

const {
	title = both('seo.title'),
	description = both('seo.description'),
	noindex = false,
	structuredData = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.seo.ogImage, Astro.site);

/**
 * Структурирани данни – САМО потвърдена информация:
 * име, адвокат, град, LinkedIn, области на практика.
 * Адрес, телефон и личен номер са по Единния адвокатски регистър.
 */
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': ['LegalService', 'Attorney'],
	name: site.brand,
	alternateName: t('site.person'),
	url: Astro.site?.toString(),
	image: ogImage.toString(),
	logo: new URL('/images/logo.png', Astro.site).toString(),
	description: t('seo.description'),
	address: {
		'@type': 'PostalAddress',
		streetAddress: t('site.addressLine1'),
		postalCode: site.contact.postalCode,
		addressLocality: t('site.city'),
		addressCountry: 'BG',
	},
	telephone: site.contact.phone,
	email: site.contact.email,
	areaServed: { '@type': 'City', name: t('site.city') },
	knowsAbout: services.map((s) => t(`services.items.${s.key}.title`)),
	founder: {
		'@type': 'Person',
		name: t('site.fullName'),
		jobTitle: t('site.jobTitle'),
		memberOf: { '@type': 'Organization', name: t('site.barAssociation') },
		alumniOf: { '@type': 'CollegeOrUniversity', name: t('site.university') },
		identifier: {
			'@type': 'PropertyValue',
			name: t('site.registryLabel'),
			value: site.registryNumber,
		},
		sameAs: [site.linkedin],
	},
	sameAs: [site.linkedin],
	inLanguage: ['bg', 'en'],
};
---

<!doctype html>
<html lang="bg" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- Езикът се задава преди първото рендиране, за да няма премигване -->
		<script is:inline>
			(function () {
				try {
					var l = localStorage.getItem('hl-lang');
					if (l === 'en' || l === 'bg') document.documentElement.lang = l;
				} catch (e) {}
				document.documentElement.classList.add('js');
			})();
		</script>
		<title {...l10n(title)}>{title.bg}</title>
		<meta name="description" {...l10nAttr({ content: description })} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#0c1626" />
		<meta name="color-scheme" content="light dark" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Open Graph / Twitter -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.brand} />
		<meta property="og:locale" content="bg_BG" {...l10nAttr({ content: { bg: 'bg_BG', en: 'en_GB' } })} />
		<meta property="og:title" {...l10nAttr({ content: title })} />
		<meta property="og:description" {...l10nAttr({ content: description })} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" {...i18nAttr({ content: 'seo.ogAlt' })} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" {...l10nAttr({ content: title })} />
		<meta name="twitter:description" {...l10nAttr({ content: description })} />
		<meta name="twitter:image" content={ogImage} />

		{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<a href="#main" class="skip-link" {...i18n('nav.skip')}>{t('nav.skip')}</a>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<script src="../scripts/main.ts"></script>
	</body>
</html>
