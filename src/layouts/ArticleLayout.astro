---
/**
 * Layout за отделна публикация (/publikacii/<slug>).
 * Демо статиите носят обозначение и не се индексират.
 */
import BaseLayout from './BaseLayout.astro';
import Button from '../components/Button.astro';
import Logo from '../components/Logo.astro';
import Clock from '@lucide/astro/icons/clock';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import { site } from '../data/site';

interface Props {
	title: string;
	category: string;
	summary: string;
	date: Date;
	readingTime: number;
	demo: boolean;
}
const { title, category, summary, date, readingTime, demo } = Astro.props;
const fmt = new Intl.DateTimeFormat('bg-BG', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${title} | ${site.brand}`} description={summary} noindex={demo}>
	<article class="article theme-light">
		<div class="container article__inner">
			<a href="/#publikacii" class="article__back u-link">
				<ArrowLeft size={16} aria-hidden="true" /> Всички публикации
			</a>

			<header class="article__head">
				<p class="eyebrow">{category}</p>
				<h1 class="article__title">{title}</h1>
				<p class="article__summary">{summary}</p>
				<p class="article__meta">
					<time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time>
					<span class="article__dot" aria-hidden="true"></span>
					<span class="article__time"><Clock size={14} aria-hidden="true" /> {readingTime} мин четене</span>
					{demo && <span class="demo-badge">Демо съдържание</span>}
				</p>
			</header>

			{
				demo && (
					<p class="article__notice" role="note">
						Примерна статия, която показва оформлението на публикациите. Не представлява публикувано
						становище на адвокат Хинков и подлежи на замяна с реален текст.
					</p>
				)
			}

			<div class="article__body prose">
				<slot />
			</div>

			<footer class="article__foot">
				<div class="article__author">
					<Logo size={40} class="article__mark" />
					<div>
						<p class="article__author-name">{site.person}</p>
						<p class="muted">{site.barAssociation}</p>
					</div>
				</div>
				<div class="article__cta">
					<p>Имате въпрос по темата?</p>
					<Button href="/#kontakti" variant="primary" arrow>Запази консултация</Button>
				</div>
			</footer>
		</div>
	</article>
</BaseLayout>

<style>
	.article {
		padding-top: calc(var(--header-h) + clamp(3rem, 6vw, 5rem));
		padding-bottom: var(--section-y);
		background: var(--paper);
		color: var(--ink);
	}
	.article__inner {
		max-width: 46rem;
	}
	.article__back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 2.5rem;
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}
	.article__head {
		display: grid;
		gap: 1rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--line);
	}
	.article__title {
		font-size: var(--text-h2);
		margin-top: 0.25rem;
	}
	.article__summary {
		font-size: var(--text-lg);
		color: var(--fg-muted);
		line-height: 1.55;
	}
	.article__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		font-size: var(--text-sm);
		color: var(--fg-subtle);
	}
	.article__dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--bronze-2);
	}
	.article__time {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.demo-badge {
		display: inline-block;
		padding: 0.2rem 0.55rem;
		border: 1px dashed var(--line-strong);
		border-radius: 999px;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fg-subtle);
	}
	.article__notice {
		margin-top: 1.5rem;
		padding: 0.9rem 1.1rem;
		border: 1px dashed var(--line-strong);
		border-radius: var(--radius);
		background: var(--paper-2);
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}
	.article__body {
		margin-top: 2.5rem;
	}
	.article__body :global(h2) {
		font-size: var(--text-h3);
		margin: 2.25rem 0 0.75rem;
		padding-top: 0;
		border-top: 0;
	}
	.article__body :global(p) {
		font-size: var(--text-md);
		line-height: 1.7;
	}
	.article__body :global(em) {
		color: var(--fg-subtle);
	}
	.article__foot {
		display: grid;
		gap: 2rem;
		margin-top: 3.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}
	.article__author {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: var(--text-sm);
	}
	.article__mark {
		color: var(--bronze-deep);
		flex: none;
	}
	.article__author-name {
		font-family: var(--font-display);
		font-size: 1.15rem;
	}
	.article__cta {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
		padding: 1.5rem;
		background: var(--navy-900);
		color: var(--cream);
		border-radius: var(--radius-lg);
	}
	@media (min-width: 40rem) {
		.article__foot {
			grid-template-columns: 1fr auto;
			align-items: center;
		}
	}
</style>
