---
/**
 * Процес за резервиране на консултация в 3 стъпки.
 * Markup: тук и в подкомпонентите. Поведение: src/scripts/booking.ts. Стилове: src/styles/booking.css
 * (глобални с префикс .bk-, защото част от елементите се генерират в браузъра).
 * Настройки и интеграция с Microsoft Bookings: src/config/booking.ts.
 */
import '../../styles/booking.css';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import CircleCheck from '@lucide/astro/icons/circle-check';
import CircleAlert from '@lucide/astro/icons/circle-alert';
import ExternalLink from '@lucide/astro/icons/external-link';
import BookingProgress from './BookingProgress.astro';
import ServiceSelector from './ServiceSelector.astro';
import BookingCalendar from './BookingCalendar.astro';
import AvailableTimes from './AvailableTimes.astro';
import BookingDetailsForm from './BookingDetailsForm.astro';
import { BOOKING_CONFIG } from '../../config/booking';
import { t, i18n, i18nAttr } from '../../i18n';
---

<section class="bk" data-booking aria-labelledby="bk-title">
	<header class="bk__head">
		<h3 id="bk-title" class="bk__title" {...i18n('booking.title')}>{t('booking.title')}</h3>
		<p class="bk__sub" {...i18n('booking.sub')}>{t('booking.sub')}</p>
	</header>

	<form class="bk__form" data-booking-form novalidate>
		<!-- Стъпка 1 -->
		<div class="bk__panel" data-step-panel="1">
			<h4 class="bk__step-title" tabindex="-1" data-step-title {...i18n('booking.step1Title')}>{t('booking.step1Title')}</h4>
			<ServiceSelector />
			<div class="bk__actions">
				<span></span>
				<button type="button" class="bk-btn bk-btn--primary" data-next disabled>
					<span {...i18n('booking.next')}>{t('booking.next')}</span> <ArrowRight size={18} stroke-width={1.7} aria-hidden="true" />
				</button>
			</div>
		</div>

		<!-- Стъпка 2 -->
		<div class="bk__panel" data-step-panel="2" hidden>
			<h4 class="bk__step-title" tabindex="-1" data-step-title {...i18n('booking.step2Title')}>{t('booking.step2Title')}</h4>
			<div class="bk__schedule">
				<BookingCalendar />
				<AvailableTimes />
			</div>
			<div class="bk__actions">
				<button type="button" class="bk-btn bk-btn--ghost" data-back>
					<ArrowLeft size={18} stroke-width={1.7} aria-hidden="true" /> <span {...i18n('booking.back')}>{t('booking.back')}</span>
				</button>
				<button type="button" class="bk-btn bk-btn--primary" data-next disabled>
					<span {...i18n('booking.next')}>{t('booking.next')}</span> <ArrowRight size={18} stroke-width={1.7} aria-hidden="true" />
				</button>
			</div>
		</div>

		<!-- Стъпка 3 -->
		<div class="bk__panel" data-step-panel="3" hidden>
			<h4 class="bk__step-title" tabindex="-1" data-step-title {...i18n('booking.step3Title')}>{t('booking.step3Title')}</h4>
			<dl class="bk-summary" data-summary {...i18nAttr({ 'aria-label': 'booking.summaryAria' })}>
				<div><dt {...i18n('booking.summaryType')}>{t('booking.summaryType')}</dt><dd data-summary-service>–</dd></div>
				<div data-summary-when-row><dt {...i18n('booking.summaryWhen')}>{t('booking.summaryWhen')}</dt><dd data-summary-when>–</dd></div>
			</dl>
			<BookingDetailsForm />
			<div class="bk__actions">
				<button type="button" class="bk-btn bk-btn--ghost" data-back>
					<ArrowLeft size={18} stroke-width={1.7} aria-hidden="true" /> <span {...i18n('booking.back')}>{t('booking.back')}</span>
				</button>
				<button type="submit" class="bk-btn bk-btn--primary" data-submit {...i18n('booking.submit')}>
					{t('booking.submit')}
				</button>
			</div>
			<p class="bk__status" data-booking-status role="status" aria-live="polite"></p>
			<p class="bk__disclaimer" {...i18n('booking.disclaimer')}>{t('booking.disclaimer')}</p>
		</div>
	</form>

	<!-- Успех -->
	<div class="bk__done" data-booking-success hidden tabindex="-1">
		<CircleCheck size={40} stroke-width={1.4} aria-hidden="true" />
		<h4 {...i18n('booking.successTitle')}>{t('booking.successTitle')}</h4>
		<p data-success-text {...i18n('booking.successDefault')}>{t('booking.successDefault')}</p>
		{
			BOOKING_CONFIG.bookingPageUrl && (
				<a
					class="bk-btn bk-btn--primary"
					href={BOOKING_CONFIG.bookingPageUrl}
					target="_blank"
					rel="noopener noreferrer"
					data-success-bookings
				>
					<span {...i18n('booking.successBookings')}>{t('booking.successBookings')}</span> <ExternalLink size={16} aria-hidden="true" />
				</a>
			)
		}
		<p class="bk__disclaimer" {...i18n('booking.disclaimer')}>{t('booking.disclaimer')}</p>
	</div>

	<!-- Грешка при изпращане -->
	<div class="bk__failure" data-booking-failure hidden role="alert">
		<CircleAlert size={22} aria-hidden="true" />
		<p {...i18n('booking.failure')}>{t('booking.failure')}</p>
	</div>

	<BookingProgress />
</section>

<script>
	import { initBooking } from '../../scripts/booking';
	initBooking();
</script>
