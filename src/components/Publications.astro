---
/**
 * Публикации – трите най-нови статии от колекцията src/content/publications/.
 * Всяка карта води към пълния текст на /publikacii/<slug>.
 */
import { getCollection } from 'astro:content';
import PublicationCard from './PublicationCard.astro';
import Button from './Button.astro';
import { t, i18n } from '../i18n';
import { pairPosts } from '../i18n/publications';

const pairs = pairPosts(await getCollection('publications')).slice(0, 3);
const hasDemo = pairs.some((p) => p.bg.data.demo);
---

<section id="publikacii" class="section theme-light publications" aria-labelledby="pub-title">
	<div class="container">
		<header class="publications__head">
			<div>
				<p class="eyebrow" data-reveal {...i18n('publications.eyebrow')}>{t('publications.eyebrow')}</p>
				<h2 id="pub-title" data-reveal style="--reveal-delay:1" {...i18n('publications.title')}>
					{t('publications.title')}
				</h2>
			</div>
			<p class="publications__note" data-reveal style="--reveal-delay:2">
				{hasDemo && <span class="demo-badge" {...i18n('publications.demoBadge')}>{t('publications.demoBadge')}</span>}
				<span {...i18n(hasDemo ? 'publications.demoNote' : 'publications.note')}>{t(hasDemo ? 'publications.demoNote' : 'publications.note')}</span>
			</p>
		</header>

		<div class="publications__grid">
			{pairs.map((pair, i) => <PublicationCard pair={pair} index={i} />)}
		</div>

		<div class="publications__more" data-reveal>
			<Button href="/publikacii" variant="link" {...i18n('publications.all')}>{t('publications.all')}</Button>
		</div>
	</div>
</section>

<style>
	.publications__head {
		display: grid;
		gap: 1.5rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}
	.publications__head h2 {
		margin-top: 1rem;
		max-width: 16ch;
	}
	.publications__note {
		font-size: var(--text-sm);
		color: var(--fg-muted);
		max-width: 30rem;
	}
	.demo-badge {
		display: inline-block;
		margin-right: 0.5rem;
		padding: 0.2rem 0.55rem;
		border: 1px dashed var(--line-strong);
		border-radius: 999px;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fg-subtle);
	}
	.publications__grid {
		display: grid;
		gap: 1.25rem;
	}
	.publications__more {
		margin-top: 2rem;
	}
	@media (min-width: 40rem) {
		.publications__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 56rem) {
		.publications__head {
			grid-template-columns: 1fr auto;
			align-items: end;
		}
		.publications__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}
</style>
