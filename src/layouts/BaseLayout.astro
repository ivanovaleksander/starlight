---
/**
 * Основен layout: <head> с SEO, Open Graph, структурирани данни,
 * самостоятелно хоствани шрифтове, skip link, header и footer.
 */
import '@fontsource-variable/manrope';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, services } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/** За подстраници с временно съдържание – да не се индексират. */
	noindex?: boolean;
	/** Включва JSON-LD за LegalService/Attorney (само на началната страница). */
	structuredData?: boolean;
}

const {
	title = site.seo.title,
	description = site.seo.description,
	noindex = false,
	structuredData = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.seo.ogImage, Astro.site);

/**
 * Структурирани данни – САМО потвърдена информация:
 * име, адвокат, град, LinkedIn, области на практика.
 * Адрес, телефон, имейл и работно време се добавят, когато бъдат предоставени.
 */
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': ['LegalService', 'Attorney'],
	name: site.brand,
	alternateName: site.person,
	url: Astro.site?.toString(),
	image: ogImage.toString(),
	description: site.seo.description,
	address: {
		'@type': 'PostalAddress',
		addressLocality: site.city,
		addressCountry: 'BG',
	},
	areaServed: { '@type': 'City', name: site.city },
	knowsAbout: services.map((s) => s.title),
	founder: {
		'@type': 'Person',
		name: site.personShort,
		jobTitle: 'Адвокат',
		sameAs: [site.linkedin],
	},
	sameAs: [site.linkedin],
	inLanguage: 'bg',
};
---

<!doctype html>
<html lang="bg" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#0c1626" />
		<meta name="color-scheme" content="light dark" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Open Graph / Twitter -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.brand} />
		<meta property="og:locale" content={site.seo.locale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${site.brand} – ${site.person}, ${site.city}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

		<!-- Маркира наличието на JS, за да се активират reveal анимациите -->
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Към основното съдържание</a>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<script src="../scripts/main.ts"></script>
	</body>
</html>
